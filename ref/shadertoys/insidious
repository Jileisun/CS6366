
#define T iTime
#define P(z) (vec3((sin((z)*.1))*16., (sin((z)*.04))*12., (z)))
#define R(a) mat2(cos(a), -sin(a), sin(a), cos(a))
#define N normalize

vec3 tex3D( sampler2D tex, in vec3 p, in vec3 n ){
  
    n = max((abs(n) - 0.2)*7., 0.001);
    n /= (n.x + n.y + n.z );  
    
	return (texture(tex, p.yz)*n.x + texture(tex, p.zx)*n.y + texture(tex, p.xy)*n.z).xyz;
}


float fractal(vec3 p) {
    float s,w = .5, l;
    p.x -= 1.5;
    p.y /= 2.;
    for (int i; i++ < 8; p *= l, w *= l )
        p  = abs(sin(p)) - 1.,
        l = 1.5/dot(p,p);
    return length(p)/w-.0001; 
}

float map(vec3 p) {
    p.xy -= P(p.z).xy;
    return min(fractal(p),1.25 - abs(p.y));
}

float AO(in vec3 pos, in vec3 nor) {
	float sca = 2.0, occ = 0.0;
    for( int i=0; i<5; i++ ){
    
        float hr = 0.01 + float(i)*0.5/4.0;        
        float dd = map(nor * hr + pos);
        occ += (hr - dd)*sca;
        sca *= 0.7;
    }
    return clamp( 1.0 - occ, 0.0, 1.0 );    
}

void mainImage(out vec4 o, in vec2 u) {
    float s=.0006,d=0.,i=0.;
    vec3  r = iResolution;
    u = (u-r.xy/2.)/r.y;
    
    vec3  e = vec3(.02,0,0),
          p = P(T+T),ro=p,
          Z = N( P(T+T+4.) - p),
          X = N(vec3(Z.z,0,-Z)),
          D = N(vec3(R(tanh(sin((p.z/1e1)*.5)*1e1)*3.5)*u, 1))
             * mat3(-X, cross(X, Z), Z);
    o = vec4(0);
    for(;i++ < 142. && s > .0005;)
        p = ro + D * d,
        d += s = map(p)*.8;
        
    // normal
    // tetrahedron technique: https://iquilezles.org/articles/normalsSDF/
    const float h = 0.005;
    const vec2 k = vec2(1,-1);
    r = N(k.xyy*map( p + k.xyy*h ) + 
          k.yyx*map( p + k.yyx*h ) + 
          k.yxy*map( p + k.yxy*h ) + 
          k.xxx*map( p + k.xxx*h ) );


   o.rgb = tex3D(iChannel0, p, r);
   
   for (i = .2; i < 1.2;
        o.rgb += abs(dot(sin(o.rgb * i * 32.), vec3(.03))) / i,
        i *= 1.41);
    o.rgb *= o.rgb * .25;
    
    vec3 lights = abs((vec3(4,2,1)) /
                  dot(cos(.65*T+p*.1),vec3(3e2)));
    o.rgb *= AO(p, r) * 4.;
    o.rgb += lights/4.*(11.+sin(T)*1e1);
    
    float fog = min(1.0, d/16.);
    o = mix(o, vec4(2,3,1,0)*(0.2 + fog + .5 + .5*cos(.5*T)) ,fog);
    
    o = vec4(o*o/d);
}