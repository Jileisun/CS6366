float lpDist(vec3 p, float n) {
    p = pow(abs(p), vec3(n));
    return pow(p.x + p.y + p.z, 1.0 / n);
}

vec2 de(vec3 p) {
    vec3 offset = p * 1.3;
    float s = 2.0;
    float trap = 1e5;

    for (int i = 0; i < 5; i++) {
        p = clamp(p, -1.0, 1.0) * 2.0 - p;
        float r = -10.0 * clamp(max(0.3 / pow(lpDist(p, 3.5), 2.0), 0.3), 0.0, 0.5);
        s *= r;
        p *= r;
        p += offset;
        float ang = float(i) * 0.37;
        float ca = cos(ang), sa = sin(ang);
        p.xy = mat2(ca, -sa, sa, ca) * p.xy;

        float t1 = length(p);
        float t2 = abs(p.x);
        float t3 = length(p.xy);
        trap = min(trap, min(t1 * 0.2, min(t2 * 0.4, t3 * 0.3)));
    }

    s = abs(s);
    float a = 10.0;
    p -= clamp(p, -a, a);
    return vec2(length(p) / s, clamp(trap, 0.0, 1.0));
}

float deWorld(vec3 p0) {
    vec4 p = vec4(p0, 2.0);
    gEscape = 0.0;
    p *= 2.0 / min(dot(p.xyz, p.xyz), 30.0);
    
    for (int i = 0; i < 14; i++) {
        p.xyz = vec3(2., 4., 2.) - (abs(p.xyz) - vec3(2., 4., 2.));
        p.xyz = mod(p.xyz - 4.0, 8.0) - 4.0;
        p *= 9.0 / min(dot(p.xyz, p.xyz), 12.0);
        gEscape += exp(-0.25 * dot(p.xyz, p.xyz));
    }
    p.xyz -= clamp(p.xyz, -1.2, 1.2);
    return length(p.xyz) / p.w;
}

vec3 map(vec3 p) {
    float zRepeat = 8.0;
    float zCell   = floor(p.z / zRepeat);
    float xDisp   = sin(zCell * 1.618) * 1.2;
    float yDisp   = cos(zCell * 2.399) * 0.7;

    vec3 pw = p;
    pw.z = mod(p.z, zRepeat) - zRepeat * 0.5;
    pw.x += xDisp;
    pw.y += yDisp;

    float tunnelWidth = 4.0;
    pw.x = abs(pw.x) - tunnelWidth;

    vec2 deResult = de(pw);
    float dFractal = deResult.x;
    float orbitVal = deResult.y;

    float waves = sin(p.z * 1.5 - iTime * 4.0) * 0.03;
    waves += cos(p.x * 2.0 + p.z * 0.5) * 0.02;
    float dFloor = p.y + 1.5 + waves;

    if (dFloor < dFractal) return vec3(dFloor, 1.0, 0.0);
    return vec3(dFractal, 0.0, orbitVal);
}

vec3 getNormal(vec3 p) {
    vec2 e = vec2(0.002, 0.0);
    return normalize(vec3(
        map(p + e.xyy).x - map(p - e.xyy).x,
        map(p + e.yxy).x - map(p - e.yxy).x,
        map(p + e.yyx).x - map(p - e.yyx).x
    ));
}

vec3 getNormalWorld(vec3 p) {
    float e = 0.004;
    return normalize(vec3(
        deWorld(p + vec3(e,0,0)) - deWorld(p - vec3(e,0,0)),
        deWorld(p + vec3(0,e,0)) - deWorld(p - vec3(0,e,0)),
        deWorld(p + vec3(0,0,e)) - deWorld(p - vec3(0,0,e))
    ));
}

float softShadow(vec3 ro, vec3 rd, float tmin, float tmax, float k) {
    float res = 1.0;
    float t   = tmin;
    for (int i = 0; i < 48; i++) {
        float h = map(ro + rd * t).x;
        if (h < 0.001) return 0.0;
        res = min(res, k * h / t);
        t  += clamp(h, 0.02, 0.3);
        if (t > tmax) break;
    }
    return clamp(res, 0.0, 1.0);
}

vec3 trapColor(float trap) {
    vec3 c0 = vec3(0.05, 0.0, 0.15); 
    vec3 c1 = vec3(0.0, 0.4, 0.6);   
    vec3 c2 = vec3(1.0, 0.7, 0.3);   
    float t = clamp(trap, 0.0, 1.0);
    if (t < 0.5) return mix(c0, c1, t * 2.0);
    return mix(c1, c2, (t - 0.5) * 2.0);
}

vec3 worldColor(float esc) {
    float t = clamp(esc / 8.0, 0.0, 1.0);
    vec3 c0 = vec3(0.002, 0.005, 0.01); 
    vec3 c1 = vec3(0.2, 0.4, 0.8);      
    vec3 c2 = vec3(1.0, 0.9, 0.8);      
    if (t < 0.5) return mix(c0, c1, t * 2.0);
    return mix(c1, c2, (t - 0.5) * 2.0);
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i + vec2(0,0)), hash(i + vec2(1,0)), u.x),
               mix(hash(i + vec2(0,1)), hash(i + vec2(1,1)), u.x), u.y);
}
float fbm(vec2 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 5; i++) {
        v += a * noise(p);
        p = p * 2.1 + vec2(1.7, 9.2);
        a *= 0.5;
    }
    return v;
}

vec3 aurora(vec3 rd, vec3 ro) {
    vec2 sky = rd.xy * 2.5 + vec2(ro.z * 0.02, 0.0);
    float t = iTime * 0.08;
    float f = pow(fbm(sky + t * 0.5) * fbm(sky * 1.5 - t * 0.3), 1.5) * 4.0;
    
    vec3 c1 = vec3(0.05, 0.1, 0.4); 
    vec3 c2 = vec3(0.4, 0.05, 0.6); 
    vec3 c3 = vec3(0.1, 0.6, 0.7); 

    vec3 col = mix(vec3(0.002), c1, clamp(f, 0.0, 1.0));
    col = mix(col, c2, clamp(f*f - 0.2, 0.0, 1.0));
    col = mix(col, c3, clamp(pow(f, 5.0), 0.0, 1.0));
    
    float sun = pow(max(dot(rd, normalize(vec3(-0.4, 0.6, 0.5))), 0.0), 12.0);
    col += vec3(1.0, 0.8, 0.6) * sun * 0.5;

    return col * smoothstep(-0.4, 0.6, rd.y + 0.4);
}

float cheapFog(vec3 p) {
    vec2 drift = p.xz * 0.2 + vec2(0.0, iTime * 0.3);
    float n = noise(drift) * noise(drift * 0.5 - iTime * 0.1);
    
    float fogHeight = 0.6 + sin(iTime * 0.5) * 0.4;
    float verticalFalloff = exp(-(p.y + 1.5) / fogHeight);
    
    return n * 0.35 * verticalFalloff;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;

    float loopDuration = 100.0, halfLoop = 50.0;
    float localTime = mod(iTime, loopDuration);
    
    float travelPos = localTime < halfLoop ? localTime : loopDuration - localTime;
    float direction = localTime < halfLoop ? 1.0 : -1.0;
    float speed = travelPos * 0.5;

    float lookYaw = sin(iTime * 0.22) * 0.45 + sin(iTime * 0.4) * 0.1;
    float lookPitch = 0.1 + sin(iTime * 0.17) * 0.15 + cos(iTime * 0.33) * 0.2;
    float roll = sin(iTime * 0.5) * 0.05;

    vec3 ro = vec3(0.0, -0.2 + sin(iTime * 1.2) * 0.05, speed);
    
    vec3 forward = normalize(vec3(sin(lookYaw), lookPitch, cos(lookYaw) * direction));
    vec3 right = normalize(cross(forward, vec3(sin(roll), 1.0, 0.0)));
    vec3 up = cross(right, forward);
    vec3 rd = normalize(uv.x * right + uv.y * up + 1.5 * forward);

    float t = 0.0;
    vec3 hit;
    for (int i = 0; i < 150; i++) {
        hit = map(ro + rd * t);
        if (hit.x < 0.001 || t > 60.0) break;
        t += hit.x * 0.55;
    }

    vec3 lightDir = normalize(vec3(-0.4, 0.6, 0.5 * direction));
    vec3 col = vec3(0.0);

    if (t >= 50.0) {
        vec3 worldOrigin = ro * 0.15 + rd * 2.0;
        float tw = 0.0;
        bool worldHit = false;
        for (int i = 0; i < 100; i++) {
            float dw = deWorld(worldOrigin + rd * tw);
            if (dw < 0.002) { worldHit = true; break; }
            tw += dw * 0.45;
            if (tw > 160.0) break;
        }

        if (worldHit) {
            vec3 wp = worldOrigin + rd * tw;
            vec3 wn = getNormalWorld(wp);
            float fres = pow(1.0 - max(dot(wn, -rd), 0.0), 5.0);
            vec3 refl = aurora(reflect(rd, wn), ro);
            col = worldColor(gEscape) * 0.1 + refl * fres * 1.5;
            col = mix(col, vec3(0.002, 0.005, 0.01), 1.0 - exp(-0.015 * tw));
        } else {
            col = aurora(rd, ro);
        }
    } else {
        vec3 p = ro + rd * t, n = getNormal(p);
        float shade = softShadow(p + n * 0.01, lightDir, 0.05, 20.0, 16.0);
        float fres = pow(1.0 - max(dot(n, -rd), 0.0), 5.0);

        if (hit.y == 1.0) {
            vec3 reflDir = reflect(rd, n);
            vec3 reflCol = vec3(.0);
            
            float rt = 0.02;
            vec3 rhit;
            for(int i=0; i<128; i++) {
                rhit = map(p + n * 0.01 + reflDir * rt);
                if(rhit.x < 0.005 || rt > 50.0) break;
                rt += rhit.x * 0.6;
            }
            
            if(rt < 25.0) {
                reflCol = trapColor(rhit.z) * 0.2;
            } else {
                reflCol = aurora(reflDir, p) * 0.5;
            }

            float spec = pow(max(dot(n, normalize(lightDir - rd)), 0.0), 512.0); 
            col = vec3(0.002) + reflCol * (0.1 + fres * 0.9) + spec * shade * 3.0;
        } else {
            vec3 base = trapColor(hit.z);
            float spec = pow(max(dot(reflect(-lightDir, n), -rd), 0.0), 64.0);
            col = base * (max(dot(n, lightDir), 0.0) * shade + 0.05) + fres * aurora(reflect(rd, n), p) * 0.4 + spec * shade;
        }
        
        float fogAmount = 1.0 - exp(-0.03 * t);
        float localFog = cheapFog(p);
        
        vec3 fogColor = vec3(0.005, 0.01, 0.02);
        col = mix(col, fogColor, clamp(fogAmount + localFog, 0.0, 1.0));
    }

    col *= pow(1.0 - dot(uv * 0.8, uv * 0.8), 2.0);
    fragColor = vec4(pow(max(col, 0.0), vec3(0.4545)), 1.0);
}